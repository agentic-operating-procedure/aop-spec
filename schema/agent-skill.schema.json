{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-operating-procedure/aop-spec/schema/agent-skill.schema.json",
  "title": "Agent Skill Declaration",
  "description": "Schema for a conformant Agent Skill declaration per the normative contract annex (SK-1 to SK-2).",
  "type": "object",
  "required": ["id", "name", "purpose", "inputs", "outputs", "requires", "must_not", "reporting", "test"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+/SK-[A-Z0-9-]+@v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "description"],
        "additionalProperties": false,
        "properties": {
          "class": { "enum": ["credential", "access", "context"] },
          "description": { "type": "string" }
        }
      }
    },
    "must_not": { "type": "array", "items": { "type": "string" } },
    "reporting": { "type": "string", "minLength": 1 },
    "test": { "type": "string", "minLength": 1, "description": "Reference to the independent test for this skill (SK-5)." }
  }
}
