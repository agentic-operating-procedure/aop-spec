{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-operating-procedure/aop-spec/schema/aop-document.schema.json",
  "title": "AOP Document",
  "description": "Schema for a conformant Agentic Operating Procedure document. Implements the normative model clauses NM-MODEL-1 to NM-MODEL-3, the procedure structure NM-STR-1 to NM-STR-7, and the provenance block NM-PRV-1. Uses a documented subset of JSON Schema draft 2020-12; the reference validator implements exactly this subset.",
  "type": "object",
  "required": [
    "aop", "version", "lifecycle",
    "intent", "context", "constraints", "authority",
    "capabilities", "coordination", "control", "assurance",
    "structure", "provenance", "governance"
  ],
  "additionalProperties": false,
  "properties": {
    "aop": {
      "description": "AOP identifier in the <domain>/<AP-id> form (NM-ID-1, NM-ID-2).",
      "type": "string",
      "pattern": "^[a-z0-9-]+/(AP|HR)-[A-Z0-9-]+$"
    },
    "version": {
      "description": "Semantic version of this AOP (NM-VER-1).",
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "lifecycle": {
      "description": "Three separate status dimensions, not one status field (NM-VER-4).",
      "type": "object",
      "required": ["specification_status", "release_status", "operational_applicability"],
      "additionalProperties": false,
      "properties": {
        "specification_status": { "enum": ["draft", "under-review", "under-assessment", "approved", "rejected", "withdrawn"] },
        "release_status": { "enum": ["not-released", "released", "withdrawn-from-distribution"] },
        "operational_applicability": { "enum": ["not-effective", "effective", "restricted", "suspended", "superseded", "retired"] }
      }
    },
    "intent": {
      "description": "Dimension 1: the operational objective as a verifiable outcome condition (NM-INT-1 to NM-INT-3).",
      "type": "object",
      "required": ["objective", "outcome_condition", "scope_boundary"],
      "additionalProperties": true,
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "outcome_condition": { "type": "string", "minLength": 1 },
        "scope_boundary": {
          "type": "object",
          "required": ["in_scope", "out_of_scope"],
          "additionalProperties": false,
          "properties": {
            "in_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "out_of_scope": { "type": "array", "items": { "type": "string" } }
          }
        },
        "intent_hypothesis": { "type": "string", "description": "The claim derived from the source SOP that observation tested (NM-INT-3)." }
      }
    },
    "process_alignment": {
      "description": "Association with the OpenDEA Business Process Catalog, by reference or declared gap, and the metric bindings for the human baseline (NM-INT-4, NM-INT-5).",
      "type": "object",
      "required": ["process_catalog_version"],
      "additionalProperties": false,
      "properties": {
        "process_ref": {
          "type": "string",
          "pattern": "^processes:process-[a-z0-9-]+$",
          "description": "The catalog process this procedure is an occurrence of (CG-PA-1)."
        },
        "process_gap": {
          "type": "string",
          "minLength": 1,
          "description": "Where no canonical entry exists (CG-PA-5): the gap to lodge as a contribution to dea-catalog-business-processes."
        },
        "process_catalog_version": { "type": "string", "minLength": 1 },
        "metric_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "metric_ref": { "type": "string", "pattern": "^dea:metric-[a-z0-9-]+$" },
              "gap": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "context": {
      "description": "Dimension 2: context elements with source, access rule and minimisation (NM-CTX-1 to NM-CTX-4).",
      "type": "object",
      "required": ["elements", "snapshot_semantics", "minimisation_rule"],
      "additionalProperties": true,
      "properties": {
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "source", "access_rule"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "source": { "type": "string" },
              "access_rule": { "type": "string" }
            }
          }
        },
        "snapshot_semantics": { "type": "string", "minLength": 1 },
        "minimisation_rule": { "type": "string", "minLength": 1 }
      }
    },
    "constraints": {
      "description": "Dimension 3: permitted set, prohibitions, fail-closed rule (NM-CON-1 to NM-CON-4).",
      "type": "object",
      "required": ["permitted_actions", "prohibited_actions", "fail_closed"],
      "additionalProperties": true,
      "properties": {
        "permitted_actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "prohibited_actions": { "type": "array", "items": { "type": "string" } },
        "fail_closed": { "const": true, "description": "The fail-closed rule is mandatory and cannot be switched off (NM-CON-3)." }
      }
    },
    "authority": {
      "description": "Dimension 4: decision-rights ladder over the five risk axes and the rule-level authority classes (NM-AUT-1 to NM-AUT-6).",
      "type": "object",
      "required": ["risk_axes", "decision_rights_ladder"],
      "additionalProperties": true,
      "properties": {
        "default_authority_class": {
          "description": "The authority class for permitted actions not covered by a decision rule (NM-AUT-3). Where absent, uncovered actions are prohibited.",
          "$ref": "#/$defs/authorityClass"
        },
        "risk_axes": {
          "description": "Assessment over the five risk axes: risk, reversibility, operational impact, authority threshold, assurance requirement (NM-AUT-5).",
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["axis", "assessment"],
            "additionalProperties": false,
            "properties": {
              "axis": { "enum": ["risk", "reversibility", "operational-impact", "authority-threshold", "assurance-requirement"] },
              "assessment": { "type": "string", "minLength": 1 }
            }
          }
        },
        "decision_rights_ladder": {
          "description": "Mapping from risk-axis position to the minimum authority class (NM-AUT-6).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["condition", "minimum_authority_class"],
            "additionalProperties": false,
            "properties": {
              "condition": { "type": "string", "minLength": 1 },
              "minimum_authority_class": { "$ref": "#/$defs/authorityClass" }
            }
          }
        }
      }
    },
    "capabilities": {
      "description": "Dimension 5: enumerated skills and tools with credential requirements (NM-CAP-1 to NM-CAP-4).",
      "type": "object",
      "required": ["skills"],
      "additionalProperties": true,
      "properties": {
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "credential_class"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+/SK-[A-Z0-9-]+@v[0-9]+\\.[0-9]+\\.[0-9]+$" },
              "credential_class": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "coordination": {
      "description": "Dimension 6: handoffs, escalation routes, external system contracts (NM-CRD-1 to NM-CRD-3).",
      "type": "object",
      "required": ["handoffs", "escalation_routes"],
      "additionalProperties": true,
      "properties": {
        "handoffs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["from", "to", "payload", "acknowledgement"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "payload": { "type": "string" },
              "acknowledgement": { "type": "string" },
              "kind": {
                "enum": ["approval", "informational"],
                "description": "An approval handoff routes a decision to the recipient; an informational handoff only informs. Default is approval."
              }
            }
          }
        },
        "escalation_routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["authority_class", "target_role", "evidence_bundle"],
            "additionalProperties": false,
            "properties": {
              "authority_class": { "enum": ["approval-required", "prohibited", "unknown"] },
              "target_role": { "type": "string" },
              "evidence_bundle": { "$ref": "#/$defs/evidenceBundleRef" }
            }
          }
        }
      }
    },
    "control": {
      "description": "Dimension 7: validation obligations, exception binding, intervention, drift obligation (NM-CTL-1 to NM-CTL-4).",
      "type": "object",
      "required": ["validation_obligations", "intervention", "drift_obligation"],
      "additionalProperties": true,
      "properties": {
        "validation_obligations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "intervention": { "type": "string", "minLength": 1 },
        "drift_obligation": { "type": "string", "minLength": 1 }
      }
    },
    "assurance": {
      "description": "Dimension 8: case record, human baseline, replay obligation, no self-modification (NM-ASR-1 to NM-ASR-4).",
      "type": "object",
      "required": ["case_record", "human_baseline", "replay"],
      "additionalProperties": true,
      "properties": {
        "case_record": {
          "type": "object",
          "required": ["append_only", "fields"],
          "additionalProperties": false,
          "properties": {
            "append_only": { "const": true },
            "fields": { "type": "array", "minItems": 7, "items": { "type": "string" } }
          }
        },
        "human_baseline": {
          "type": "object",
          "required": ["metrics"],
          "additionalProperties": true,
          "properties": {
            "metrics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["metric", "observed_value"],
                "additionalProperties": false,
                "properties": {
                  "metric": { "type": "string" },
                  "observed_value": { "type": ["number", "string"] }
                }
              }
            }
          }
        },
        "replay": { "const": true }
      }
    },
    "structure": {
      "description": "The network-native procedure structure: variants, decision points, exception edges, rework loops (NM-STR-1 to NM-STR-7).",
      "type": "object",
      "required": ["variants", "exception_edges", "rework_loops"],
      "additionalProperties": false,
      "properties": {
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "frequency", "trigger", "steps", "decision_rules", "provenance"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^VAR-[A-Z0-9-]+$" },
              "name": { "type": "string", "minLength": 1 },
              "frequency": { "type": "number", "minimum": 0, "maximum": 1 },
              "trigger": { "type": "string", "minLength": 1 },
              "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "decision_rules": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/decisionRule" }
              },
              "provenance": { "$ref": "#/$defs/ruleProvenance" }
            }
          }
        },
        "exception_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["condition", "behaviour"],
            "additionalProperties": true,
            "properties": {
              "condition": { "type": "string", "minLength": 1 },
              "behaviour": { "enum": ["validated-path", "recover", "escalate"] },
              "target_role": { "type": "string" },
              "severity": { "enum": ["low", "moderate", "high", "critical"] }
            }
          }
        },
        "rework_loops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["return_condition", "iteration_bound", "bound_exceeded_behaviour"],
            "additionalProperties": false,
            "properties": {
              "return_condition": { "type": "string", "minLength": 1 },
              "iteration_bound": { "type": "integer", "minimum": 1 },
              "bound_exceeded_behaviour": { "enum": ["escalate", "recover"] }
            }
          }
        }
      }
    },
    "provenance": {
      "description": "Provenance block (NM-PRV-1 to NM-PRV-3).",
      "type": "object",
      "required": ["source", "derived_from"],
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string", "pattern": "^cg://case/.+@[0-9TZ:.-]+$" },
        "derived_from": {
          "type": "object",
          "required": ["observed_cases", "variants", "last_recalibrated"],
          "additionalProperties": false,
          "properties": {
            "observed_cases": { "type": "integer", "minimum": 1 },
            "variants": { "type": "integer", "minimum": 1 },
            "last_recalibrated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" }
          }
        },
        "source_sop": { "type": "string", "description": "Identifier and version of the source SOP where one exists (NM-PRV-2)." }
      }
    },
    "governance": {
      "description": "Governance bounds: permitted action audit target (NM-CON-1, SEC-8).",
      "type": "object",
      "required": ["audit"],
      "additionalProperties": true,
      "properties": {
        "audit": { "const": "case-record" }
      }
    }
  },
  "$defs": {
    "authorityClass": {
      "enum": ["autonomous", "approval-required", "prohibited"]
    },
    "decisionRule": {
      "type": "object",
      "required": ["if", "then", "authority"],
      "additionalProperties": false,
      "properties": {
        "if": { "type": "string", "minLength": 1 },
        "then": { "type": "string", "minLength": 1 },
        "authority": { "$ref": "#/$defs/authorityClass" },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Optional action scope: the rule governs only the actions it names."
        },
        "provenance": { "$ref": "#/$defs/ruleProvenance" }
      }
    },
    "ruleProvenance": {
      "type": "object",
      "required": ["observed_cases", "path_frequency"],
      "additionalProperties": false,
      "properties": {
        "observed_cases": { "type": "integer", "minimum": 1 },
        "path_frequency": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidenceBundleRef": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to the evidence bundle contents for this route; the bundle shape is fixed by evidence-bundle.schema.json."
    }
  }
}
